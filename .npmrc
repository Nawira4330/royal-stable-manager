# npm 11+ blockiert Installations-Skripte standardmaessig. Electron und
# electron-builder laden ihre Binaerdateien per postinstall - hier erlaubt,
# damit ein bedarfsweises "npm install" die Desktop-App wieder lauffaehig macht.
# Die Browser-Variante (serve.ps1) braucht das alles nicht.
allow-scripts=electron,electron-builder
