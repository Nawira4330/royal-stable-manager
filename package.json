{
  "name": "gestuetsspiel",
  "productName": "Royal Stable Manager",
  "version": "0.2.0",
  "description": "Pferdegestüt-Aufbauspiel mit echter Farbgenetik, Zucht, Training, Schauen und Auktionen. Läuft im Browser oder als Desktop-App (Electron).",
  "main": "electron-main.js",
  "author": "Nawira13",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node tools/get-electron.js --run",
    "electron": "node tools/get-electron.js",
    "dist": "node tools/get-electron.js && npx --yes electron-builder@25.1.8 --win --x64",
    "dist:portable": "node tools/get-electron.js && npx --yes electron-builder@25.1.8 --win portable --x64",
    "icons": "node tools/make-icons.js",
    "clean": "node tools/clean.js"
  },
  "build": {
    "appId": "de.nawira13.gestuetsspiel",
    "productName": "Royal Stable Manager",
    "files": ["index.html", "electron-main.js", "css/**", "js/**", "manifest.webmanifest", "sw.js", "favicon.png", "icons/**"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "RoyalStableManager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Royal Stable Manager"
    }
  }
}
